# Design_4/.env

# OpenWeatherMap API
OPENWEATHER_API_KEY="detallar la API KEY"

# PostgreSQL
DB_USER=postgres
DB_HOST=localhost
DB_DATABASE="nombre de la base de datos"
DB_PASSWORD="contraseña de la base de datos"
DB_PORT="puerto de la base de datos"

# Servidor
PORT="puerto del ambiente de desarrollo"
NODE_ENV=development